/-!
# Finitely many coordinates: correspondence

Wiki correspondence for the law and concentration of the number of open coordinates in a finite
set, the zero-one law for events invariant under finite modification, the image of an event under
a finite overwrite, and the pivotal factorisation on an arbitrary index type.

## Main results

* `finite_count_assignment_and_binomial_laws`
* `finite_count_exponential_moment_and_hoeffding`
* `finite_modification_invariance_zero_one`
* `overwrite_law_and_finite_image`
* `pivotal_factorisation_and_open_pivotal_count`
-/

@[expose] public section
noncomputable section
open MeasureTheory ProbabilityTheory Set
open scoped ENNReal

namespace PercLib.Probability
variable {I : Type*}

open scoped Classical in
/-- The number of open coordinates in a finite set `F` takes the value `k` with the
probability of the assignment sum; in the homogeneous case this is the binomial law; and it
never exceeds `|F|`. -/
@[tag "CPD6"]
theorem finite_count_assignment_and_binomial_laws (p : I → unitInterval) (F : Finset I) :
    (∀ k : ℕ, (prodBernoulli p).real {ω | (ω ∩ (F : Set I)).ncard = k} =
      ∑ a ∈ F.powersetCard k, (∏ i ∈ a, (p i : ℝ)) * ∏ i ∈ F \ a, (1 - (p i : ℝ))) ∧
    (∀ r : unitInterval, (∀ i ∈ F, p i = r) → ∀ k : ℕ,
      (prodBernoulli p).real {ω | (ω ∩ (F : Set I)).ncard = k} =
        (F.card.choose k) * (r : ℝ) ^ k * (1 - (r : ℝ)) ^ (F.card - k)) ∧
    (∀ k : ℕ, F.card < k → (prodBernoulli p).real {ω | (ω ∩ (F : Set I)).ncard = k} = 0) :=
  ⟨prodBernoulli_real_ncard_inter_finset_eq_sum p F,
    fun _ hp => prodBernoulli_real_ncard_inter_finset_eq p F hp,
    fun _ hk => prodBernoulli_real_ncard_inter_finset_eq_zero_of_card_lt p F hk⟩

/-- The centred count of open coordinates in a finite set `F` has exponential moments at most
`exp(|F| t² / 8)`, both one-sided Hoeffding tails, the two-sided bound
`min {1, 2 exp(-2t²/|F|)}`, and for empty `F` each one-sided event is certain at `t ≤ 0` and
impossible at `t > 0`. -/
@[tag "XSA6"]
theorem finite_count_exponential_moment_and_hoeffding (p : I → unitInterval) (F : Finset I) :
    (∀ t : ℝ, ∫ ω, Real.exp (t * (((ω ∩ (F : Set I)).ncard : ℝ) - ∑ i ∈ F, (p i : ℝ)))
        ∂prodBernoulli p ≤ Real.exp (F.card * t ^ 2 / 8)) ∧
    (∀ t : ℝ, 0 ≤ t →
      (prodBernoulli p).real {ω | t ≤ ((ω ∩ (F : Set I)).ncard : ℝ) - ∑ i ∈ F, (p i : ℝ)} ≤
        Real.exp (-2 * t ^ 2 / F.card)) ∧
    (∀ t : ℝ, 0 ≤ t →
      (prodBernoulli p).real {ω | t ≤ ∑ i ∈ F, (p i : ℝ) - ((ω ∩ (F : Set I)).ncard : ℝ)} ≤
        Real.exp (-2 * t ^ 2 / F.card)) ∧
    (∀ t : ℝ, 0 ≤ t →
      (prodBernoulli p).real
          {ω | t ≤ |((ω ∩ (F : Set I)).ncard : ℝ) - ∑ i ∈ F, (p i : ℝ)|} ≤
        min 1 (2 * Real.exp (-2 * t ^ 2 / F.card))) ∧
    (∀ t : ℝ, (prodBernoulli p).real
        {ω | t ≤ ((ω ∩ ((∅ : Finset I) : Set I)).ncard : ℝ) - ∑ i ∈ ∅, (p i : ℝ)} =
      if t ≤ 0 then 1 else 0) ∧
    (∀ t : ℝ, (prodBernoulli p).real
        {ω | t ≤ ∑ i ∈ ∅, (p i : ℝ) - ((ω ∩ ((∅ : Finset I) : Set I)).ncard : ℝ)} =
      if t ≤ 0 then 1 else 0) :=
  ⟨integral_exp_mul_ncard_inter_finset_sub_sum_le p F,
    fun _ ht => prodBernoulli_real_sum_sub_ge_le p F ht,
    fun _ ht => prodBernoulli_real_sub_sum_ge_le p F ht,
    fun _ ht => prodBernoulli_real_abs_sub_ge_le p F ht,
    prodBernoulli_real_sum_sub_ge_empty p,
    prodBernoulli_real_sub_sum_ge_empty p⟩

/-- A measurable event whose membership never changes when one coordinate is opened is
unchanged by every finite modification, is measurable for the σ-algebra generated by the
coordinates outside each finite set, and has probability zero or one, for every profile on an
arbitrary coordinate set. -/
@[tag "D1CH"]
theorem finite_modification_invariance_zero_one (p : I → unitInterval) {A : Set (Set I)}
    (hA : MeasurableSet A) (hflip : ∀ ω i, insert i ω ∈ A ↔ ω ∈ A) :
    (∀ ω ω' : Set I, (symmDiff ω ω').Finite → (ω ∈ A ↔ ω' ∈ A)) ∧
    (∀ F : Finset I, MeasurableSet[MeasurableSpace.comap
      (fun ω : Set I => {i : ((F : Set I)ᶜ : Set I) | (i : I) ∈ ω}) inferInstance] A) ∧
    (prodBernoulli p A = 0 ∨ prodBernoulli p A = 1) :=
  ⟨fun _ _ h => mem_iff_of_insert_iff_of_finite_symmDiff hflip h,
    measurableSet_comap_restrict_compl_of_insert_iff hA hflip,
    prodBernoulli_eq_zero_or_one_of_insert_iff p hA hflip⟩

open scoped Classical in
/-- Overwriting a block `F` by a fixed assignment `a ⊆ F` pushes the product law forward to the
product law with marginals one on `a`, zero on `F \ a` and unchanged outside `F`. For finite `F`
and measurable `A`, the set `S_A` of outside configurations admitting an assignment on `F` in `A`
is measurable, the image of `A` is measurable, its probability is `w_q(a;F) P_{q|Fᶜ}(S_A)`, and
this is at least `w_q(a;F) P_q(A)`. -/
@[tag "DL0X"]
theorem overwrite_law_and_finite_image (p : I → unitInterval) :
    (∀ F a : Set I, a ⊆ F →
      (prodBernoulli p).map (fun ω => (ω \ F) ∪ a) =
        prodBernoulli (fun i => if i ∈ F then (if i ∈ a then 1 else 0) else p i)) ∧
    (∀ F a : Finset I, a ⊆ F → ∀ A : Set (Set I), MeasurableSet A →
      MeasurableSet {ξ : Set ((F : Set I)ᶜ : Set I) |
        ∃ b ∈ F.powerset, (Subtype.val '' ξ : Set I) ∪ (b : Set I) ∈ A} ∧
      MeasurableSet ((fun ω => (ω \ (F : Set I)) ∪ (a : Set I)) '' A) ∧
      prodBernoulli p ((fun ω => (ω \ (F : Set I)) ∪ (a : Set I)) '' A) =
        (∏ i ∈ a, (unitInterval.toNNReal (p i) : ℝ≥0∞)) *
          (∏ i ∈ F \ a, (unitInterval.toNNReal (unitInterval.symm (p i)) : ℝ≥0∞)) *
          prodBernoulli (fun i : ((F : Set I)ᶜ : Set I) => p i)
            {ξ | ∃ b ∈ F.powerset, (Subtype.val '' ξ : Set I) ∪ (b : Set I) ∈ A} ∧
      (∏ i ∈ a, (unitInterval.toNNReal (p i) : ℝ≥0∞)) *
          (∏ i ∈ F \ a, (unitInterval.toNNReal (unitInterval.symm (p i)) : ℝ≥0∞)) *
          prodBernoulli p A ≤
        (∏ i ∈ a, (unitInterval.toNNReal (p i) : ℝ≥0∞)) *
          (∏ i ∈ F \ a, (unitInterval.toNNReal (unitInterval.symm (p i)) : ℝ≥0∞)) *
          prodBernoulli (fun i : ((F : Set I)ᶜ : Set I) => p i)
            {ξ | ∃ b ∈ F.powerset, (Subtype.val '' ξ : Set I) ∪ (b : Set I) ∈ A}) :=
  ⟨fun F a ha => prodBernoulli_map_overwrite p F a ha,
    fun F a ha _ hA => ⟨measurableSet_setOf_exists_image_val_union_mem F hA,
      measurableSet_image_overwrite F a ha hA, prodBernoulli_image_overwrite p F a ha hA,
      mul_prodBernoulli_le_mul_prodBernoulli_compl_exists_union_mem p F a hA⟩⟩

open scoped Classical in
/-- On an arbitrary coordinate set, the pivotal event of a measurable event at `e` is
measurable and does not depend on the state of `e`, and its open and closed parts have
probabilities `q_e` and `1 - q_e` times its probability; an increasing event splits disjointly
into the configurations that stay in it after closing `e` and the open pivotal ones. On a finite
coordinate set, the open-pivotal count is the event indicator times the pivotal count, its mean is
`∑_e q_e P(Π_e)`, and for an increasing event and a homogeneous parameter `0 < p ≤ 1` the
derivative of `P_p(A)` (one-sided at `p = 1`) is `p⁻¹` times either expectation. -/
@[tag "XRSL"]
theorem pivotal_factorisation_and_open_pivotal_count {E : Type*} [Fintype E] :
    (∀ (q : I → unitInterval) {A : Set (Set I)}, MeasurableSet A → ∀ e : I,
      MeasurableSet {ω : Set I | insert e ω ∈ A ∧ ω \ {e} ∉ A} ∧
      (∀ ω ω' : Set I, ω \ {e} = ω' \ {e} →
        ((insert e ω ∈ A ∧ ω \ {e} ∉ A) ↔ (insert e ω' ∈ A ∧ ω' \ {e} ∉ A))) ∧
      (prodBernoulli q).real {ω | (insert e ω ∈ A ∧ ω \ {e} ∉ A) ∧ e ∈ ω} =
        (q e : ℝ) * (prodBernoulli q).real {ω | insert e ω ∈ A ∧ ω \ {e} ∉ A} ∧
      (prodBernoulli q).real {ω | (insert e ω ∈ A ∧ ω \ {e} ∉ A) ∧ e ∉ ω} =
        (1 - (q e : ℝ)) * (prodBernoulli q).real {ω | insert e ω ∈ A ∧ ω \ {e} ∉ A}) ∧
    (∀ {A : Set (Set I)}, IsUpperSet A → ∀ e : I,
      A = {ω | ω \ {e} ∈ A} ∪ {ω | (insert e ω ∈ A ∧ ω \ {e} ∉ A) ∧ e ∈ ω} ∧
      Disjoint {ω | ω \ {e} ∈ A} {ω | (insert e ω ∈ A ∧ ω \ {e} ∉ A) ∧ e ∈ ω}) ∧
    (∀ (A : Set (Set E)) (ω : Set E),
      (if ω ∈ A then ∑ e, if insert e ω ∈ A ∧ ω \ {e} ∉ A then (1 : ℝ) else 0 else 0) =
        ∑ e, if (insert e ω ∈ A ∧ ω \ {e} ∉ A) ∧ e ∈ ω then (1 : ℝ) else 0) ∧
    (∀ (q : E → unitInterval) (A : Set (Set E)),
      (∫ ω, (∑ e, if (insert e ω ∈ A ∧ ω \ {e} ∉ A) ∧ e ∈ ω then (1 : ℝ) else 0)
        ∂prodBernoulli q) =
        ∑ e, (q e : ℝ) * (prodBernoulli q).real {ω | insert e ω ∈ A ∧ ω \ {e} ∉ A}) ∧
    (∀ {A : Set (Set E)}, IsUpperSet A → ∀ p : unitInterval, 0 < p →
      HasDerivWithinAt (fun t => (prodBernoulli
          (fun _ : E => projIcc 0 1 zero_le_one t)).real A)
        ((1 / (p : ℝ)) * ∫ ω,
          (∑ e, if (insert e ω ∈ A ∧ ω \ {e} ∉ A) ∧ e ∈ ω then (1 : ℝ) else 0)
          ∂prodBernoulli (fun _ => p)) (Icc 0 1) p ∧
      HasDerivWithinAt (fun t => (prodBernoulli
          (fun _ : E => projIcc 0 1 zero_le_one t)).real A)
        ((1 / (p : ℝ)) * ∫ ω,
          (if ω ∈ A then ∑ e, if insert e ω ∈ A ∧ ω \ {e} ∉ A then (1 : ℝ) else 0 else 0)
          ∂prodBernoulli (fun _ => p)) (Icc 0 1) p) :=
  ⟨fun q _ hA e => ⟨measurableSet_setOf_insert_mem_and_sdiff_notMem hA e,
      fun _ _ h => insert_mem_and_sdiff_notMem_iff_of_sdiff_eq _ e h,
      prodBernoulli_real_open_pivotal_of_measurableSet q hA e,
      prodBernoulli_real_closed_pivotal_of_measurableSet q hA e⟩,
    fun hA e => ⟨eq_setOf_sdiff_mem_union_open_pivotal hA e,
      disjoint_setOf_sdiff_mem_open_pivotal _ e⟩,
    pivotal_count_on_event,
    integral_open_pivotal_count,
    fun hA p hp => ⟨prodBernoulli_hasDerivWithinAt_open_pivotal hA p hp,
      prodBernoulli_hasDerivWithinAt_pivotal_on_event hA p hp⟩⟩

end PercLib.Probability
