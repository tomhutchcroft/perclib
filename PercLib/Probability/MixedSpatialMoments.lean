/-
New proofs, written on 2026-11-16: volume bias bounds absolute mixed spatial moments of a random
finite set (wiki spatial-cutoff-moments, tag VMEJ). No upstream proof is copied, no definition is
added and no Input is introduced.
-/
module

public import Mathlib.Algebra.Module.BigOperators
public import Mathlib.Analysis.InnerProductSpace.Continuous
public import Mathlib.Analysis.MeanInequalities
public import Mathlib.Analysis.SpecialFunctions.Pow.Continuity
public import Mathlib.Data.Nat.Factorial.DoubleFactorial
public import Mathlib.MeasureTheory.Function.SpecialFunctions.Basic
public import Mathlib.MeasureTheory.Integral.MeanInequalities
public import Mathlib.MeasureTheory.Measure.Dirac.Basic

/-! # Mixed spatial moments of a random finite set

Let `K` be a random finite nonempty subset of an inner product space with
`χ = E|K| < ∞`, let `Q` be the law weighted by `|K|/χ`, and let `X` be uniform on `K` under
`Q`, so that `E_Q[g(K)] = E[|K| g(K)]/χ` and
`E_Q[h(X)] = E[|K| · |K|⁻¹ ∑_{x ∈ K} h(x)]/χ`. For products `P_i(x) = ∏_j ⟨x, u_{ij}⟩`
(`i < n`) of total degree `p ≥ 1`,

`E ∑_{x₁,…,x_n ∈ K} ∏ |P_i(x_i)| ≤ χ (E_Q |K|^{2n-2})^{1/2} max_{ij} (E_Q |⟨X,u_{ij}⟩|^{2p})^{1/2}`

(`lintegral_mixedMoment_le`, VMEJ), with values in `ℝ≥0∞`. Conditionally on `K`, AM-GM over
the `p` linear factors bounds the sum by `p⁻¹ ∑_{ij} |K|^{n-1} ∑_{x ∈ K} |⟨x,u_{ij}⟩|^p`, and
Cauchy–Schwarz (first over `K`, then in `ω`) bounds each term.

The corollary `mixedMoment_le_of_moment_bounds` turns the bounds
`E_Q|K|^{2n-2} ≤ (1+ε₁)(4n-5)‼ m^{2n-2}` and
`E_Q|⟨X,u⟩|^{2p} ≤ (1+ε₂) C₀^{2p} (2p)! σ^{2p}` into
`((1+ε₁)(1+ε₂))^{1/2} C^{n+p} n! p! χ m^{n-1} σ^p` with `C = max 4 (2 C₀)`;
`tendsto_mixedMoment_error` shows that the error factor tends to `1` when `ε₁, ε₂ → 0`.

**Measurability.** The σ-algebra on `Finset E` in mathlib is generated by the events `x ∈ K`
for single points `x`, which does not make `|K|` measurable when `E` is uncountable. The
hypothesis on `K` is therefore that it is a measurable point process:
`ω ↦ ∑_{x ∈ K ω} g x` is measurable for every measurable `g : E → ℝ≥0∞`.
-/

@[expose] public section
noncomputable section

open MeasureTheory Finset
open scoped ENNReal NNReal RealInnerProductSpace Nat

namespace PercLib.Probability

/-- **AM-GM over a finite family.** `∏ a ≤ |s|⁻¹ ∑ a^{|s|}` in `ℝ≥0∞`. -/
theorem prod_le_inv_card_mul_sum_pow {ι : Type*} (s : Finset ι) (a : ι → ℝ≥0∞)
    (hs : s.Nonempty) : ∏ f ∈ s, a f ≤ (#s : ℝ≥0∞)⁻¹ * ∑ f ∈ s, a f ^ #s := by
  have hc : (#s : ℝ≥0) ≠ 0 := by exact_mod_cast hs.card_pos.ne'
  have hw : ∑ _f ∈ s, (#s : ℝ≥0)⁻¹ = 1 := by
    rw [sum_const, nsmul_eq_mul, mul_inv_cancel₀ hc]
  have h := ENNReal.geom_mean_le_arith_mean_weighted s (fun _ => (#s : ℝ≥0)⁻¹)
    (fun f => a f ^ #s) hw
  have hl : ∀ f, (a f ^ #s) ^ (((#s : ℝ≥0)⁻¹ : ℝ≥0) : ℝ) = a f := fun f => by
    rw [← ENNReal.rpow_natCast, ← ENNReal.rpow_mul, NNReal.coe_inv, NNReal.coe_natCast,
      mul_inv_cancel₀ (by exact_mod_cast hc), ENNReal.rpow_one]
  simp only [hl] at h
  refine h.trans_eq ?_
  rw [mul_sum]
  refine sum_congr rfl fun f _ => ?_
  rw [ENNReal.coe_inv hc, ENNReal.coe_natCast]

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- The extended norm of a finite product of reals is the product of the extended norms. -/
theorem enorm_prod_real {ι : Type*} (s : Finset ι) (g : ι → ℝ) :
    ‖∏ j ∈ s, g j‖ₑ = ∏ j ∈ s, ‖g j‖ₑ := by
  simp only [enorm_eq_nnnorm, nnnorm_prod, ENNReal.ofNNReal_finsetProd]

/-- **Pointwise.** For a finite nonempty `K` and products of linear forms of total degree
`p ≥ 1`, `∑_{x ∈ K^n} ∏_i |P_i(x_i)| ≤ p⁻¹ ∑_{ij} |K|^{n-1} ∑_{y ∈ K} |⟨y, u_{ij}⟩|^p`. -/
theorem sum_piFinset_prod_le (K : Finset E) {n p : ℕ} (deg : Fin n → ℕ)
    (u : (i : Fin n) → Fin (deg i) → E) (hp : ∑ i, deg i = p) (hp1 : 1 ≤ p) :
    ∑ x ∈ Fintype.piFinset (fun _ : Fin n => K), ∏ i, ‖∏ j, ⟪x i, u i j⟫‖ₑ ≤
      (p : ℝ≥0∞)⁻¹ * ∑ f : (Σ i, Fin (deg i)),
        (#K : ℝ≥0∞) ^ (n - 1) * ∑ y ∈ K, ‖⟪y, u f.1 f.2⟫‖ₑ ^ p := by
  classical
  have hcard : #(univ : Finset (Σ i, Fin (deg i))) = p := by
    rw [card_univ, Fintype.card_sigma]
    simp [hp]
  have hne : (univ : Finset (Σ i, Fin (deg i))).Nonempty := by
    rw [← card_pos, hcard]
    exact hp1
  calc ∑ x ∈ Fintype.piFinset (fun _ : Fin n => K), ∏ i, ‖∏ j, ⟪x i, u i j⟫‖ₑ
      = ∑ x ∈ Fintype.piFinset (fun _ : Fin n => K),
          ∏ f : (Σ i, Fin (deg i)), ‖⟪x f.1, u f.1 f.2⟫‖ₑ := by
        refine sum_congr rfl fun x _ => ?_
        rw [Fintype.prod_sigma]
        exact prod_congr rfl fun i _ => enorm_prod_real _ _
    _ ≤ ∑ x ∈ Fintype.piFinset (fun _ : Fin n => K),
          (p : ℝ≥0∞)⁻¹ * ∑ f : (Σ i, Fin (deg i)), ‖⟪x f.1, u f.1 f.2⟫‖ₑ ^ p := by
        refine sum_le_sum fun x _ => ?_
        have h := prod_le_inv_card_mul_sum_pow univ
          (fun f : (Σ i, Fin (deg i)) => ‖⟪x f.1, u f.1 f.2⟫‖ₑ) hne
        rwa [hcard] at h
    _ = (p : ℝ≥0∞)⁻¹ * ∑ f : (Σ i, Fin (deg i)),
          ∑ x ∈ Fintype.piFinset (fun _ : Fin n => K), ‖⟪x f.1, u f.1 f.2⟫‖ₑ ^ p := by
        rw [← mul_sum, sum_comm]
    _ = (p : ℝ≥0∞)⁻¹ * ∑ f : (Σ i, Fin (deg i)),
          (#K : ℝ≥0∞) ^ (n - 1) * ∑ y ∈ K, ‖⟪y, u f.1 f.2⟫‖ₑ ^ p := by
        congr 1
        refine sum_congr rfl fun f _ => ?_
        rw [Fintype.sum_piFinset_apply (fun y => ‖⟪y, u f.1 f.2⟫‖ₑ ^ p) K f.1,
          Fintype.card_fin, nsmul_eq_mul, Nat.cast_pow]

/-- **Cauchy–Schwarz over `K`.** `|K|^k ∑_{y∈K} g(y) ≤ (|K| |K|^{2k})^{1/2} (∑_{y∈K} g(y)²)^{1/2}`.
-/
theorem pow_mul_sum_le {α : Type*} (K : Finset α) (g : α → ℝ≥0∞) (k : ℕ) :
    (#K : ℝ≥0∞) ^ k * ∑ y ∈ K, g y ≤
      ((#K : ℝ≥0∞) * (#K : ℝ≥0∞) ^ (2 * k)) ^ (1 / 2 : ℝ) *
        (∑ y ∈ K, g y ^ 2) ^ (1 / 2 : ℝ) := by
  have h := ENNReal.inner_le_Lp_mul_Lq K (fun _ => (#K : ℝ≥0∞) ^ k) g Real.HolderConjugate.two_two
  rw [mul_sum]
  refine h.trans_eq ?_
  congr 2
  · rw [sum_const, nsmul_eq_mul, ENNReal.rpow_two, ← pow_mul, mul_comm k 2]
  · exact sum_congr rfl fun y _ => ENNReal.rpow_two (g y)

variable {Ω : Type*} [MeasurableSpace Ω]

/-- **Cauchy–Schwarz in `ω`.** If `ω ↦ ∑_{x ∈ K ω} g x` is measurable for measurable `g`, then
`E[|K|^k ∑_{y∈K} g(y)] ≤ (E[|K| |K|^{2k}])^{1/2} (E ∑_{y∈K} g(y)²)^{1/2}`. -/
theorem lintegral_pow_mul_sum_le (P : Measure Ω) {α : Type*} [MeasurableSpace α]
    (K : Ω → Finset α)
    (hK : ∀ g : α → ℝ≥0∞, Measurable g → Measurable fun ω => ∑ x ∈ K ω, g x)
    {g : α → ℝ≥0∞} (hg : Measurable g) (k : ℕ) :
    ∫⁻ ω, (#(K ω) : ℝ≥0∞) ^ k * ∑ y ∈ K ω, g y ∂P ≤
      (∫⁻ ω, (#(K ω) : ℝ≥0∞) * (#(K ω) : ℝ≥0∞) ^ (2 * k) ∂P) ^ (1 / 2 : ℝ) *
        (∫⁻ ω, ∑ y ∈ K ω, g y ^ 2 ∂P) ^ (1 / 2 : ℝ) := by
  have hN : Measurable fun ω => (#(K ω) : ℝ≥0∞) := by
    simpa using hK (fun _ => 1) measurable_const
  have hF : Measurable fun ω => (#(K ω) : ℝ≥0∞) * (#(K ω) : ℝ≥0∞) ^ (2 * k) :=
    hN.mul (hN.pow_const _)
  have hG : Measurable fun ω => ∑ y ∈ K ω, g y ^ 2 := hK _ (hg.pow_const 2)
  have hsq : ∀ x : ℝ≥0∞, (x ^ (1 / 2 : ℝ)) ^ (2 : ℝ) = x := fun x => by
    rw [← ENNReal.rpow_mul]
    norm_num
  calc ∫⁻ ω, (#(K ω) : ℝ≥0∞) ^ k * ∑ y ∈ K ω, g y ∂P
      ≤ ∫⁻ ω, ((fun ω => ((#(K ω) : ℝ≥0∞) * (#(K ω) : ℝ≥0∞) ^ (2 * k)) ^ (1 / 2 : ℝ)) *
          fun ω => (∑ y ∈ K ω, g y ^ 2) ^ (1 / 2 : ℝ)) ω ∂P :=
        lintegral_mono fun ω => pow_mul_sum_le (K ω) g k
    _ ≤ (∫⁻ ω, (((#(K ω) : ℝ≥0∞) * (#(K ω) : ℝ≥0∞) ^ (2 * k)) ^ (1 / 2 : ℝ)) ^ (2 : ℝ) ∂P) ^
          (1 / 2 : ℝ) *
        (∫⁻ ω, ((∑ y ∈ K ω, g y ^ 2) ^ (1 / 2 : ℝ)) ^ (2 : ℝ) ∂P) ^ (1 / 2 : ℝ) :=
        ENNReal.lintegral_mul_le_Lp_mul_Lq P Real.HolderConjugate.two_two
          (hF.pow_const _).aemeasurable (hG.pow_const _).aemeasurable
    _ = _ := by simp only [hsq]

variable [MeasurableSpace E] [OpensMeasurableSpace E]

/-- **Mixed spatial moments.** Let `K` be a random finite nonempty subset of `E` under a probability
measure `P`, measurable in the sense that `ω ↦ ∑_{x ∈ K ω} g x` is measurable for measurable `g`,
with `χ = E|K| < ∞`. Let `P_i(x) = ∏_{j < deg i} ⟨x, u i j⟩` for `i < n`, of total degree
`p = ∑ deg i ≥ 1`. Writing `E_Q[h] = E[|K| h]/χ` and the uniform choice of `X ∈ K` as the average
`|K|⁻¹ ∑_{x∈K}`,
`E ∑_{x ∈ K^n} ∏_i |P_i(x_i)| ≤ χ (E_Q |K|^{2n-2})^{1/2} max_{ij} (E_Q |⟨X, u_{ij}⟩|^{2p})^{1/2}`.
-/
theorem lintegral_mixedMoment_le (P : Measure Ω) [IsProbabilityMeasure P] (K : Ω → Finset E)
    (hne : ∀ ω, (K ω).Nonempty)
    (hK : ∀ g : E → ℝ≥0∞, Measurable g → Measurable fun ω => ∑ x ∈ K ω, g x)
    (hχ : ∫⁻ ω, (#(K ω) : ℝ≥0∞) ∂P ≠ ⊤) {n p : ℕ} (deg : Fin n → ℕ)
    (u : (i : Fin n) → Fin (deg i) → E) (hp : ∑ i, deg i = p) (hp1 : 1 ≤ p) :
    ∫⁻ ω, ∑ x ∈ Fintype.piFinset (fun _ : Fin n => K ω), ∏ i, ‖∏ j, ⟪x i, u i j⟫‖ₑ ∂P ≤
      (∫⁻ ω, (#(K ω) : ℝ≥0∞) ∂P) *
        ((∫⁻ ω, (#(K ω) : ℝ≥0∞) * (#(K ω) : ℝ≥0∞) ^ (2 * n - 2) ∂P) /
          ∫⁻ ω, (#(K ω) : ℝ≥0∞) ∂P) ^ (1 / 2 : ℝ) *
        ⨆ f : (Σ i, Fin (deg i)),
          ((∫⁻ ω, (#(K ω) : ℝ≥0∞) *
              ((#(K ω) : ℝ≥0∞)⁻¹ * ∑ x ∈ K ω, ‖⟪x, u f.1 f.2⟫‖ₑ ^ (2 * p)) ∂P) /
            ∫⁻ ω, (#(K ω) : ℝ≥0∞) ∂P) ^ (1 / 2 : ℝ) := by
  classical
  set χ := ∫⁻ ω, (#(K ω) : ℝ≥0∞) ∂P
  have hN : Measurable fun ω => (#(K ω) : ℝ≥0∞) := by
    simpa using hK (fun _ => 1) measurable_const
  have hN1 : ∀ ω, (1 : ℝ≥0∞) ≤ #(K ω) := fun ω => by
    exact_mod_cast (hne ω).card_pos
  have hχ0 : χ ≠ 0 := by
    refine (lt_of_lt_of_le zero_lt_one ?_).ne'
    calc (1 : ℝ≥0∞) = ∫⁻ _, 1 ∂P := by simp
      _ ≤ χ := lintegral_mono hN1
  have hmeas : ∀ (v : E) (q : ℕ), Measurable fun y : E => ‖⟪y, v⟫‖ₑ ^ q := fun v q =>
    ((continuous_id.inner continuous_const).enorm.measurable).pow_const q
  set M := ⨆ f : (Σ i, Fin (deg i)),
    (∫⁻ ω, ∑ y ∈ K ω, (‖⟪y, u f.1 f.2⟫‖ₑ ^ p) ^ 2 ∂P) ^ (1 / 2 : ℝ) with hM
  set A := ∫⁻ ω, (#(K ω) : ℝ≥0∞) * (#(K ω) : ℝ≥0∞) ^ (2 * n - 2) ∂P with hA
  have hcard : (Fintype.card (Σ i, Fin (deg i)) : ℝ≥0∞) = p := by
    rw [Fintype.card_sigma]
    simp [hp]
  have hp0 : (p : ℝ≥0∞) ≠ 0 := by exact_mod_cast (by omega : p ≠ 0)
  have h2n : 2 * (n - 1) = 2 * n - 2 := by omega
  -- the bound before rewriting `E_Q`
  have hbound : ∫⁻ ω, ∑ x ∈ Fintype.piFinset (fun _ : Fin n => K ω),
      ∏ i, ‖∏ j, ⟪x i, u i j⟫‖ₑ ∂P ≤ A ^ (1 / 2 : ℝ) * M := by
    calc ∫⁻ ω, ∑ x ∈ Fintype.piFinset (fun _ : Fin n => K ω), ∏ i, ‖∏ j, ⟪x i, u i j⟫‖ₑ ∂P
        ≤ ∫⁻ ω, (p : ℝ≥0∞)⁻¹ * ∑ f : (Σ i, Fin (deg i)),
            (#(K ω) : ℝ≥0∞) ^ (n - 1) * ∑ y ∈ K ω, ‖⟪y, u f.1 f.2⟫‖ₑ ^ p ∂P :=
          lintegral_mono fun ω => sum_piFinset_prod_le (K ω) deg u hp hp1
      _ = (p : ℝ≥0∞)⁻¹ * ∑ f : (Σ i, Fin (deg i)),
            ∫⁻ ω, (#(K ω) : ℝ≥0∞) ^ (n - 1) * ∑ y ∈ K ω, ‖⟪y, u f.1 f.2⟫‖ₑ ^ p ∂P := by
          have hmf : ∀ f : (Σ i, Fin (deg i)), Measurable fun ω =>
              (#(K ω) : ℝ≥0∞) ^ (n - 1) * ∑ y ∈ K ω, ‖⟪y, u f.1 f.2⟫‖ₑ ^ p := fun f =>
            (hN.pow_const _).mul (hK _ (hmeas _ _))
          rw [lintegral_const_mul _ (Finset.measurable_sum _ fun f _ => hmf f),
            lintegral_finsetSum _ fun f _ => hmf f]
      _ ≤ (p : ℝ≥0∞)⁻¹ * ∑ _f : (Σ i, Fin (deg i)), A ^ (1 / 2 : ℝ) * M := by
          gcongr with f
          refine (lintegral_pow_mul_sum_le P K hK (hmeas _ p) (n - 1)).trans ?_
          rw [hA, h2n]
          gcongr
          exact le_iSup (fun f : (Σ i, Fin (deg i)) =>
            (∫⁻ ω, ∑ y ∈ K ω, (‖⟪y, u f.1 f.2⟫‖ₑ ^ p) ^ 2 ∂P) ^ (1 / 2 : ℝ)) f
      _ = A ^ (1 / 2 : ℝ) * M := by
          rw [sum_const, card_univ, nsmul_eq_mul, hcard, ← mul_assoc,
            ENNReal.inv_mul_cancel hp0 (ENNReal.natCast_ne_top p), one_mul]
  refine hbound.trans_eq ?_
  -- rewrite `E_Q`
  have hQ : ∀ f : (Σ i, Fin (deg i)),
      ∫⁻ ω, (#(K ω) : ℝ≥0∞) * ((#(K ω) : ℝ≥0∞)⁻¹ * ∑ x ∈ K ω, ‖⟪x, u f.1 f.2⟫‖ₑ ^ (2 * p)) ∂P =
        ∫⁻ ω, ∑ y ∈ K ω, (‖⟪y, u f.1 f.2⟫‖ₑ ^ p) ^ 2 ∂P := fun f => by
    refine lintegral_congr fun ω => ?_
    have h0 : (#(K ω) : ℝ≥0∞) ≠ 0 := (zero_lt_one.trans_le (hN1 ω)).ne'
    rw [← mul_assoc, ENNReal.mul_inv_cancel h0 (ENNReal.natCast_ne_top _), one_mul]
    exact sum_congr rfl fun y _ => by rw [← pow_mul, mul_comm]
  simp_rw [hQ]
  have hs0 : χ ^ (1 / 2 : ℝ) ≠ 0 := by
    simp [ENNReal.rpow_eq_zero_iff, hχ0]
  have hstop : χ ^ (1 / 2 : ℝ) ≠ ⊤ := ENNReal.rpow_ne_top_of_nonneg (by norm_num) hχ
  have hdiv : ∀ X : ℝ≥0∞, (X / χ) ^ (1 / 2 : ℝ) = X ^ (1 / 2 : ℝ) / χ ^ (1 / 2 : ℝ) :=
    fun X => ENNReal.div_rpow_of_nonneg _ _ (by norm_num)
  have hχsq : χ = χ ^ (1 / 2 : ℝ) * χ ^ (1 / 2 : ℝ) := by
    rw [← ENNReal.rpow_add _ _ hχ0 hχ]
    norm_num
  simp_rw [hdiv]
  rw [← ENNReal.iSup_div, ← hM]
  have key : ∀ s X Y : ℝ≥0∞, s ≠ 0 → s ≠ ⊤ → X * Y = s * s * (X / s) * (Y / s) :=
    fun s X Y h0 htop => by
      rw [show s * s * (X / s) * (Y / s) = (s * (X / s)) * (s * (Y / s)) by ring,
        ENNReal.mul_div_cancel h0 htop, ENNReal.mul_div_cancel h0 htop]
  have h := key (χ ^ (1 / 2 : ℝ)) (A ^ (1 / 2 : ℝ)) M hs0 hstop
  rw [← hχsq] at h
  exact h

/-! ### Factorial bounds and the corollary -/

/-- `(4k+3)‼ ≤ (4^{k+1} (k+1)!)²`. -/
theorem doubleFactorial_four_mul_add_three_le (k : ℕ) :
    (4 * k + 3)‼ ≤ (4 ^ (k + 1) * (k + 1)!) ^ 2 := by
  induction k with
  | zero => decide
  | succ k ih =>
    have e : 4 * (k + 1) + 3 = (4 * k + 3) + 2 + 2 := by ring
    rw [e, Nat.doubleFactorial_add_two, Nat.doubleFactorial_add_two,
      Nat.factorial_succ (k + 1), pow_succ]
    have h1 : (4 * k + 3 + 2 + 2) * (4 * k + 3 + 2) ≤ 16 * (k + 1 + 1) ^ 2 := by nlinarith
    calc (4 * k + 3 + 2 + 2) * ((4 * k + 3 + 2) * (4 * k + 3)‼)
        = ((4 * k + 3 + 2 + 2) * (4 * k + 3 + 2)) * (4 * k + 3)‼ := by ring
      _ ≤ (16 * (k + 1 + 1) ^ 2) * (4 ^ (k + 1) * (k + 1)!) ^ 2 :=
          Nat.mul_le_mul h1 ih
      _ = (4 ^ (k + 1) * 4 * ((k + 1 + 1) * (k + 1)!)) ^ 2 := by ring

/-- `(4n-5)‼ ≤ (4^{n-1} (n-1)!)²` for `n ≥ 1` (with `(-1)‼ = 1`). -/
theorem doubleFactorial_four_mul_sub_five_le {n : ℕ} (hn : 1 ≤ n) :
    (4 * n - 5)‼ ≤ (4 ^ (n - 1) * (n - 1)!) ^ 2 := by
  obtain ⟨k, rfl⟩ : ∃ k, n = k + 1 := ⟨n - 1, by omega⟩
  cases k with
  | zero => decide
  | succ k =>
    have e : 4 * (k + 1 + 1) - 5 = 4 * k + 3 := by omega
    rw [e, show k + 1 + 1 - 1 = k + 1 by omega]
    exact doubleFactorial_four_mul_add_three_le k

/-- `(2p)! ≤ (2^p p!)²`. -/
theorem factorial_two_mul_le (p : ℕ) : (2 * p)! ≤ (2 ^ p * p !) ^ 2 := by
  induction p with
  | zero => simp
  | succ p ih =>
    rw [show 2 * (p + 1) = 2 * p + 1 + 1 by ring, Nat.factorial_succ, Nat.factorial_succ,
      Nat.factorial_succ p, pow_succ]
    have h1 : (2 * p + 1 + 1) * (2 * p + 1) ≤ 4 * (p + 1) ^ 2 := by nlinarith
    calc (2 * p + 1 + 1) * ((2 * p + 1) * (2 * p)!)
        = ((2 * p + 1 + 1) * (2 * p + 1)) * (2 * p)! := by ring
      _ ≤ (4 * (p + 1) ^ 2) * (2 ^ p * p !) ^ 2 := Nat.mul_le_mul h1 ih
      _ = (2 ^ p * 2 * ((p + 1) * p !)) ^ 2 := by ring

/-- If `a ≤ c X²` then `a^{1/2} ≤ c^{1/2} X` in `ℝ≥0∞`. -/
theorem rpow_half_le_of_le_mul_sq {a c X : ℝ≥0∞} (h : a ≤ c * X ^ 2) :
    a ^ (1 / 2 : ℝ) ≤ c ^ (1 / 2 : ℝ) * X := by
  calc a ^ (1 / 2 : ℝ) ≤ (c * X ^ 2) ^ (1 / 2 : ℝ) := ENNReal.rpow_le_rpow h (by norm_num)
    _ = c ^ (1 / 2 : ℝ) * X := by
      rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num), ← ENNReal.rpow_natCast,
        ← ENNReal.rpow_mul]
      norm_num

/-- **Corollary (fixed error terms).** Under the hypotheses of `lintegral_mixedMoment_le`,
if `E_Q|K|^{2n-2} ≤ (1+ε₁) (4n-5)‼ m^{2n-2}` and
`E_Q|⟨X,u_{ij}⟩|^{2p} ≤ (1+ε₂) C₀^{2p} (2p)! σ^{2p}` for every factor, then the mixed moment is
at most `((1+ε₁)(1+ε₂))^{1/2} C^{n+p} n! p! χ m^{n-1} σ^p` with `C = max 4 (2 C₀)`. -/
theorem mixedMoment_le_of_moment_bounds (P : Measure Ω) [IsProbabilityMeasure P]
    (K : Ω → Finset E) (hne : ∀ ω, (K ω).Nonempty)
    (hK : ∀ g : E → ℝ≥0∞, Measurable g → Measurable fun ω => ∑ x ∈ K ω, g x)
    (hχ : ∫⁻ ω, (#(K ω) : ℝ≥0∞) ∂P ≠ ⊤) {n p : ℕ} (deg : Fin n → ℕ)
    (u : (i : Fin n) → Fin (deg i) → E) (hp : ∑ i, deg i = p) (hp1 : 1 ≤ p)
    {m σ ε₁ ε₂ : ℝ≥0∞} {C₀ : ℝ≥0}
    (hA : (∫⁻ ω, (#(K ω) : ℝ≥0∞) * (#(K ω) : ℝ≥0∞) ^ (2 * n - 2) ∂P) /
        ∫⁻ ω, (#(K ω) : ℝ≥0∞) ∂P ≤ (1 + ε₁) * ((4 * n - 5)‼ : ℝ≥0∞) * m ^ (2 * n - 2))
    (hB : ∀ f : (Σ i, Fin (deg i)),
      (∫⁻ ω, (#(K ω) : ℝ≥0∞) *
          ((#(K ω) : ℝ≥0∞)⁻¹ * ∑ x ∈ K ω, ‖⟪x, u f.1 f.2⟫‖ₑ ^ (2 * p)) ∂P) /
        ∫⁻ ω, (#(K ω) : ℝ≥0∞) ∂P ≤
      (1 + ε₂) * (C₀ : ℝ≥0∞) ^ (2 * p) * ((2 * p)! : ℝ≥0∞) * σ ^ (2 * p)) :
    ∫⁻ ω, ∑ x ∈ Fintype.piFinset (fun _ : Fin n => K ω), ∏ i, ‖∏ j, ⟪x i, u i j⟫‖ₑ ∂P ≤
      ((1 + ε₁) * (1 + ε₂)) ^ (1 / 2 : ℝ) * ((max 4 (2 * C₀) : ℝ≥0) : ℝ≥0∞) ^ (n + p) *
        (n ! : ℝ≥0∞) * (p ! : ℝ≥0∞) * (∫⁻ ω, (#(K ω) : ℝ≥0∞) ∂P) * m ^ (n - 1) * σ ^ p := by
  have hn : 1 ≤ n := by
    rcases Nat.eq_zero_or_pos n with rfl | hn
    · simp at hp
      omega
    · exact hn
  set χ := ∫⁻ ω, (#(K ω) : ℝ≥0∞) ∂P
  set C : ℝ≥0 := max 4 (2 * C₀) with hC
  refine (lintegral_mixedMoment_le P K hne hK hχ deg u hp hp1).trans ?_
  -- the volume factor
  have hAs : ((∫⁻ ω, (#(K ω) : ℝ≥0∞) * (#(K ω) : ℝ≥0∞) ^ (2 * n - 2) ∂P) / χ) ^ (1 / 2 : ℝ) ≤
      (1 + ε₁) ^ (1 / 2 : ℝ) * ((4 : ℝ≥0∞) ^ (n - 1) * ((n - 1)! : ℝ≥0∞) * m ^ (n - 1)) := by
    refine rpow_half_le_of_le_mul_sq (hA.trans ?_)
    rw [mul_assoc]
    gcongr
    have hd : ((4 * n - 5)‼ : ℝ≥0∞) ≤ ((4 ^ (n - 1) * (n - 1)! : ℕ) : ℝ≥0∞) ^ 2 := by
      exact_mod_cast doubleFactorial_four_mul_sub_five_le hn
    calc ((4 * n - 5)‼ : ℝ≥0∞) * m ^ (2 * n - 2)
        ≤ ((4 ^ (n - 1) * (n - 1)! : ℕ) : ℝ≥0∞) ^ 2 * m ^ (2 * n - 2) := by gcongr
      _ = _ := by
        rw [show 2 * n - 2 = (n - 1) * 2 by omega, pow_mul]
        push_cast
        ring
  -- the displacement factor
  have hBs : (⨆ f : (Σ i, Fin (deg i)),
      ((∫⁻ ω, (#(K ω) : ℝ≥0∞) *
          ((#(K ω) : ℝ≥0∞)⁻¹ * ∑ x ∈ K ω, ‖⟪x, u f.1 f.2⟫‖ₑ ^ (2 * p)) ∂P) / χ) ^ (1 / 2 : ℝ)) ≤
      (1 + ε₂) ^ (1 / 2 : ℝ) * ((2 : ℝ≥0∞) ^ p * (C₀ : ℝ≥0∞) ^ p * (p ! : ℝ≥0∞) * σ ^ p) := by
    refine iSup_le fun f => rpow_half_le_of_le_mul_sq ((hB f).trans ?_)
    have hd : (((2 * p)! : ℕ) : ℝ≥0∞) ≤ ((2 ^ p * p ! : ℕ) : ℝ≥0∞) ^ 2 := by
      exact_mod_cast factorial_two_mul_le p
    rw [mul_assoc, mul_assoc]
    gcongr
    have h3 : (C₀ : ℝ≥0∞) ^ (2 * p) * ((((2 * p)! : ℕ) : ℝ≥0∞) * σ ^ (2 * p)) ≤
        (C₀ : ℝ≥0∞) ^ (2 * p) * (((2 ^ p * p ! : ℕ) : ℝ≥0∞) ^ 2 * σ ^ (2 * p)) := by gcongr
    refine h3.trans_eq ?_
    rw [show 2 * p = p * 2 by ring, pow_mul, pow_mul]
    push_cast
    ring
  have h4 : (4 : ℝ≥0∞) ^ (n - 1) ≤ (C : ℝ≥0∞) ^ n := by
    calc (4 : ℝ≥0∞) ^ (n - 1) ≤ (C : ℝ≥0∞) ^ (n - 1) := by
          gcongr
          exact_mod_cast le_max_left 4 (2 * C₀)
      _ ≤ (C : ℝ≥0∞) ^ n := by
          refine pow_le_pow_right₀ ?_ (Nat.sub_le n 1)
          exact_mod_cast (show (1 : ℝ≥0) ≤ C from le_trans (by norm_num) (le_max_left _ _))
  have h2 : (2 : ℝ≥0∞) ^ p * (C₀ : ℝ≥0∞) ^ p ≤ (C : ℝ≥0∞) ^ p := by
    rw [← mul_pow]
    gcongr
    exact_mod_cast le_max_right 4 (2 * C₀)
  have hfac : ((n - 1)! : ℝ≥0∞) ≤ (n ! : ℝ≥0∞) := by
    exact_mod_cast Nat.factorial_le (Nat.sub_le n 1)
  calc χ * ((∫⁻ ω, (#(K ω) : ℝ≥0∞) * (#(K ω) : ℝ≥0∞) ^ (2 * n - 2) ∂P) / χ) ^ (1 / 2 : ℝ) *
        ⨆ f : (Σ i, Fin (deg i)),
          ((∫⁻ ω, (#(K ω) : ℝ≥0∞) *
              ((#(K ω) : ℝ≥0∞)⁻¹ * ∑ x ∈ K ω, ‖⟪x, u f.1 f.2⟫‖ₑ ^ (2 * p)) ∂P) / χ) ^ (1 / 2 : ℝ)
      ≤ χ * ((1 + ε₁) ^ (1 / 2 : ℝ) * ((4 : ℝ≥0∞) ^ (n - 1) * ((n - 1)! : ℝ≥0∞) * m ^ (n - 1))) *
        ((1 + ε₂) ^ (1 / 2 : ℝ) * ((2 : ℝ≥0∞) ^ p * (C₀ : ℝ≥0∞) ^ p * (p ! : ℝ≥0∞) * σ ^ p)) := by
        gcongr
    _ = ((1 + ε₁) * (1 + ε₂)) ^ (1 / 2 : ℝ) * ((4 : ℝ≥0∞) ^ (n - 1) *
          ((2 : ℝ≥0∞) ^ p * (C₀ : ℝ≥0∞) ^ p)) * ((n - 1)! : ℝ≥0∞) * (p ! : ℝ≥0∞) * χ *
          m ^ (n - 1) * σ ^ p := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num)]
        ring
    _ ≤ ((1 + ε₁) * (1 + ε₂)) ^ (1 / 2 : ℝ) * ((C : ℝ≥0∞) ^ n * (C : ℝ≥0∞) ^ p) *
          (n ! : ℝ≥0∞) * (p ! : ℝ≥0∞) * χ * m ^ (n - 1) * σ ^ p := by
        gcongr
    _ = _ := by rw [← pow_add]

/-- The error factor `((1+ε₁)(1+ε₂))^{1/2} - 1` tends to `0` when `ε₁, ε₂ → 0`, and adding it
to `1` recovers the factor. -/
theorem tendsto_mixedMoment_error {ι : Type*} {l : Filter ι} {ε₁ ε₂ : ι → ℝ≥0∞}
    (h₁ : Filter.Tendsto ε₁ l (nhds 0)) (h₂ : Filter.Tendsto ε₂ l (nhds 0)) :
    Filter.Tendsto (fun r => ((1 + ε₁ r) * (1 + ε₂ r)) ^ (1 / 2 : ℝ) - 1) l (nhds 0) ∧
      ∀ r, 1 + (((1 + ε₁ r) * (1 + ε₂ r)) ^ (1 / 2 : ℝ) - 1) =
        ((1 + ε₁ r) * (1 + ε₂ r)) ^ (1 / 2 : ℝ) := by
  constructor
  · have hprod : Filter.Tendsto (fun r => (1 + ε₁ r) * (1 + ε₂ r)) l (nhds 1) := by
      have a1 : Filter.Tendsto (fun r => 1 + ε₁ r) l (nhds 1) := by
        simpa using (tendsto_const_nhds (x := (1 : ℝ≥0∞))).add h₁
      have a2 : Filter.Tendsto (fun r => 1 + ε₂ r) l (nhds 1) := by
        simpa using (tendsto_const_nhds (x := (1 : ℝ≥0∞))).add h₂
      simpa using ENNReal.Tendsto.mul a1 (by simp) a2 (by simp)
    have hsq : Filter.Tendsto (fun r => ((1 + ε₁ r) * (1 + ε₂ r)) ^ (1 / 2 : ℝ)) l (nhds 1) := by
      simpa using hprod.ennrpow_const (1 / 2 : ℝ)
    simpa using ENNReal.Tendsto.sub hsq (tendsto_const_nhds (x := (1 : ℝ≥0∞))) (Or.inl (by simp))
  · intro r
    refine add_tsub_cancel_of_le ?_
    refine ENNReal.one_le_rpow ?_ (by norm_num)
    calc (1 : ℝ≥0∞) = 1 * 1 := (one_mul 1).symm
      _ ≤ (1 + ε₁ r) * (1 + ε₂ r) := by gcongr <;> exact le_self_add

/-- **Corollary along a parameter.** For a family `K_r` indexed by `r` along a filter `l`,
if `E_Q|K_r|^{2n-2} ≤ (1+ε₁(r)) (4n-5)‼ m_r^{2n-2}` and
`E_Q|⟨X_r,u_{ij}⟩|^{2p} ≤ (1+ε₂(r)) C₀^{2p} (2p)! σ_r^{2p}` with `ε₁, ε₂ → 0`, then there is
`ε → 0` (explicitly `ε = ((1+ε₁)(1+ε₂))^{1/2} - 1`) with
`E ∑_{x ∈ K_r^n} ∏ |P_i(x_i)| ≤ (1 + ε(r)) C^{n+p} n! p! χ_r m_r^{n-1} σ_r^p`, where
`C = max 4 (2 C₀)` does not depend on `n` or `p`. -/
theorem mixedMoment_le_one_add_error {ι : Type*} {l : Filter ι} (P : ι → Measure Ω)
    [∀ r, IsProbabilityMeasure (P r)] (K : ι → Ω → Finset E) (hne : ∀ r ω, (K r ω).Nonempty)
    (hK : ∀ r, ∀ g : E → ℝ≥0∞, Measurable g → Measurable fun ω => ∑ x ∈ K r ω, g x)
    (hχ : ∀ r, ∫⁻ ω, (#(K r ω) : ℝ≥0∞) ∂P r ≠ ⊤) {n p : ℕ} (deg : Fin n → ℕ)
    (u : (i : Fin n) → Fin (deg i) → E) (hp : ∑ i, deg i = p) (hp1 : 1 ≤ p)
    {m σ ε₁ ε₂ : ι → ℝ≥0∞} {C₀ : ℝ≥0}
    (hε₁ : Filter.Tendsto ε₁ l (nhds 0)) (hε₂ : Filter.Tendsto ε₂ l (nhds 0))
    (hA : ∀ r, (∫⁻ ω, (#(K r ω) : ℝ≥0∞) * (#(K r ω) : ℝ≥0∞) ^ (2 * n - 2) ∂P r) /
        ∫⁻ ω, (#(K r ω) : ℝ≥0∞) ∂P r ≤
      (1 + ε₁ r) * ((4 * n - 5)‼ : ℝ≥0∞) * m r ^ (2 * n - 2))
    (hB : ∀ r, ∀ f : (Σ i, Fin (deg i)),
      (∫⁻ ω, (#(K r ω) : ℝ≥0∞) *
          ((#(K r ω) : ℝ≥0∞)⁻¹ * ∑ x ∈ K r ω, ‖⟪x, u f.1 f.2⟫‖ₑ ^ (2 * p)) ∂P r) /
        ∫⁻ ω, (#(K r ω) : ℝ≥0∞) ∂P r ≤
      (1 + ε₂ r) * (C₀ : ℝ≥0∞) ^ (2 * p) * ((2 * p)! : ℝ≥0∞) * σ r ^ (2 * p)) :
    ∃ ε : ι → ℝ≥0∞, Filter.Tendsto ε l (nhds 0) ∧ ∀ r,
      ∫⁻ ω, ∑ x ∈ Fintype.piFinset (fun _ : Fin n => K r ω), ∏ i, ‖∏ j, ⟪x i, u i j⟫‖ₑ ∂P r ≤
        (1 + ε r) * ((max 4 (2 * C₀) : ℝ≥0) : ℝ≥0∞) ^ (n + p) * (n ! : ℝ≥0∞) *
          (p ! : ℝ≥0∞) * (∫⁻ ω, (#(K r ω) : ℝ≥0∞) ∂P r) * m r ^ (n - 1) * σ r ^ p := by
  obtain ⟨ht, heq⟩ := tendsto_mixedMoment_error hε₁ hε₂
  refine ⟨_, ht, fun r => ?_⟩
  rw [heq r]
  exact mixedMoment_le_of_moment_bounds (P r) (K r) (hne r) (hK r) (hχ r) deg u hp hp1
    (hA r) (hB r)

/-! ### Non-vacuity: a deterministic single point

For `K = {x}` (so `χ = 1`) under the point mass on `Unit`, the hypotheses hold, the left side
is `∏_i |P_i(x)|` and the right side is `max_{ij} |⟨x, u_{ij}⟩|^p`. -/

omit [NormedAddCommGroup E] [InnerProductSpace ℝ E] [OpensMeasurableSpace E] in
/-- The hypotheses of `lintegral_mixedMoment_le` hold for a deterministic singleton. -/
theorem singleton_hypotheses (x : E) :
    (∀ _ : Unit, ({x} : Finset E).Nonempty) ∧
      (∀ g : E → ℝ≥0∞, Measurable g → Measurable fun _ : Unit => ∑ y ∈ ({x} : Finset E), g y) ∧
      ∫⁻ _ : Unit, (#({x} : Finset E) : ℝ≥0∞) ∂Measure.dirac () = 1 := by
  refine ⟨fun _ => singleton_nonempty x, fun g _ => measurable_const, ?_⟩
  simp

/-- **Non-vacuity witness for `lintegral_mixedMoment_le`.** For a deterministic single point the
theorem reads `∏_i |P_i(x)| ≤ max_{ij} (|⟨x, u_{ij}⟩|^{2p})^{1/2}`. -/
theorem prod_le_of_singleton (x : E) {n p : ℕ} (deg : Fin n → ℕ)
    (u : (i : Fin n) → Fin (deg i) → E) (hp : ∑ i, deg i = p) (hp1 : 1 ≤ p) :
    ∏ i, ‖∏ j, ⟪x, u i j⟫‖ₑ ≤ ⨆ f : (Σ i, Fin (deg i)),
      (‖⟪x, u f.1 f.2⟫‖ₑ ^ (2 * p)) ^ (1 / 2 : ℝ) := by
  obtain ⟨hne, hK, hχ⟩ := singleton_hypotheses x
  have h := lintegral_mixedMoment_le (Measure.dirac ()) (fun _ : Unit => ({x} : Finset E)) hne hK
    (by rw [hχ]; exact ENNReal.one_ne_top) deg u hp hp1
  rw [hχ] at h
  simpa [Fintype.piFinset_singleton (fun _ : Fin n => x)] using h

