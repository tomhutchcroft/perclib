/-
Measure-theoretic engine for the method of moments used in Section I.5.3--I.5.4 of
T. Hutchcroft, *Critical long-range percolation I*, arXiv:2508.18807v1 (the passage from the
moment asymptotics of Theorem I.5.21 to the scaling limit of Corollary I.5.22; cf. the
discussion after (I.1.11)).

Adapted from the repository `yujinhkim/lrp`, branch `critical-lrp-1`, commit
`d382e4c28d92dd4e698ebf4f2aaf0bc932ae73fc`, file
`PercLib/CriticalLRP/MomentConvergence.lean`; licence Apache-2.0 as declared in that commit's
file headers and `third_party/critical-lrp/NOTICE.md`; upstream
`yujinhkim/Critical-Long-range-percolation` at `3b3d1d0e43ef940bfaa2292ee5c2ee094ac4edbf`.
Modified: the source definitions `monomial`, `IsMonomial`, `monomialSpan`, `monomialAlgebra`,
`HasSameMoments`, `integralFun`, `coordFun`, `polyAlgebra`, `polyFun` and `bcMon` are removed:
statements write the moments out as integrals of finite products, the algebra generated by the
test functions is mathlib's `Algebra.adjoin`, and point separation is mathlib's
`Set.SeparatesPoints`; the general results are stated for a separating subalgebra and along an
arbitrary filter; the geometric-series helpers are replaced by mathlib's
`ENNReal.tsum_geometric_add_one`; `autoImplicit` and disabled linters are removed.
-/
module

public import Mathlib.MeasureTheory.Measure.Prokhorov
public import Mathlib.MeasureTheory.Measure.Portmanteau
public import Mathlib.Topology.ContinuousMap.StoneWeierstrass

/-! # Moment determinacy and weak convergence from moment convergence

Let `Y` be a compact space. By Stone--Weierstrass, a subalgebra `A` of `C(Y, ℝ)` that
separates points is dense, so

* two finite measures on `Y` whose integrals agree on `A` are equal, and
* probability measures on `Y` whose integrals against every element of `A` converge, converge
  weakly.

Applied to the algebra generated by a separating family `Φ : T → C(Y, ℝ)` (spanned by the
monomials `∏ i, Φ (f i)`), this is moment determinacy and the method of moments. Taking
`Y = ProbabilityMeasure X` for a compact metrizable `X` and the test functions
`μ ↦ ∫ x, g x ∂μ` gives the statements for laws of random probability measures, with moments
`∫ ∏ i, ∫ x, g i x ∂μ`, in particular for polynomial test functions on a compact `K ⊆ ℝ^d`.
On a non-compact carrier, tightness replaces compactness.

## Main results

* `Algebra.adjoin_range_toSubmodule_eq_span_prod`: the algebra generated by `Φ` is spanned by
  the finite products `∏ i : Fin n, Φ (f i)`.
* `Measure.ext_of_forall_mem_subalgebra_integral_eq_of_compactSpace`,
  `ProbabilityMeasure.tendsto_of_forall_mem_subalgebra_integral_tendsto_of_compactSpace`.
* `Measure.ext_of_forall_moment_integral_eq`, `ProbabilityMeasure.tendsto_of_forall_moment_tendsto`:
  moment determinacy and the method of moments on a compact space.
* `Measure.ext_of_forall_integral_prod_integral_eq`,
  `ProbabilityMeasure.tendsto_of_forall_integral_prod_integral_tendsto` and their
  `_of_separatesPoints` forms: the same for laws of random probability measures.
* `Measure.ext_of_forall_polynomial_moment_eq`,
  `ProbabilityMeasure.tendsto_of_forall_polynomial_moment_tendsto`: polynomial moments on a
  compact `K ⊆ ℝ^d`.
* `ProbabilityMeasure.tendsto_of_isTightMeasureSet_of_moment_tendsto`: tightness, moment
  convergence and determinacy of the limit imply weak convergence.
* `ProbabilityMeasure.isTightMeasureSet_of_uniform_lintegral_bound`: tightness of laws of random
  measures from a uniform bound on the expected mass outside compact sets.
-/

@[expose] public section

open MeasureTheory Filter Topology
open scoped ENNReal NNReal BoundedContinuousFunction

namespace PercLib.Probability

/-! ### The algebra generated by a family -/

section Adjoin

variable {R B T : Type*} [CommSemiring R] [CommSemiring B] [Algebra R B]

/-- The algebra generated by the range of `Φ` is spanned, as a module, by the finite products
`∏ i : Fin n, Φ (f i)`. -/
theorem Algebra.adjoin_range_toSubmodule_eq_span_prod (Φ : T → B) :
    Subalgebra.toSubmodule (Algebra.adjoin R (Set.range Φ)) =
      Submodule.span R {b | ∃ (n : ℕ) (f : Fin n → T), ∏ i, Φ (f i) = b} := by
  rw [Algebra.adjoin_eq_span]
  congr 1
  ext b
  constructor
  · intro hb
    induction hb using Submonoid.closure_induction with
    | mem x hx =>
      obtain ⟨t, rfl⟩ := hx
      exact ⟨1, fun _ => t, by simp⟩
    | one => exact ⟨0, Fin.elim0, by simp⟩
    | mul x y _ _ hx hy =>
      obtain ⟨n, f, rfl⟩ := hx
      obtain ⟨m, g, rfl⟩ := hy
      exact ⟨n + m, Fin.append f g, by simp [Fin.prod_univ_add]⟩
  · rintro ⟨n, f, rfl⟩
    exact Submonoid.prod_mem _ fun i _ => Submonoid.subset_closure ⟨f i, rfl⟩

/-- Induction principle for the algebra generated by the range of `Φ`: a property that holds for
`0`, is stable under addition and scalar multiplication, and holds for every finite product
`∏ i : Fin n, Φ (f i)` holds on `Algebra.adjoin R (Set.range Φ)`. -/
theorem Algebra.adjoin_range_induction_prod (Φ : T → B) {p : B → Prop} (zero : p 0)
    (add : ∀ x y, p x → p y → p (x + y)) (smul : ∀ (r : R) x, p x → p (r • x))
    (prod : ∀ (n : ℕ) (f : Fin n → T), p (∏ i, Φ (f i))) {b : B}
    (hb : b ∈ Algebra.adjoin R (Set.range Φ)) : p b := by
  have hb' : b ∈ Subalgebra.toSubmodule (Algebra.adjoin R (Set.range Φ)) := hb
  rw [Algebra.adjoin_range_toSubmodule_eq_span_prod] at hb'
  clear hb
  induction hb' using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨n, f, rfl⟩ := hx
    exact prod n f
  | zero => exact zero
  | add x y _ _ hx hy => exact add x y hx hy
  | smul r x _ hx => exact smul r x hx

end Adjoin

/-- If the range of `Φ` separates points, so does the algebra it generates. -/
theorem Subalgebra.separatesPoints_adjoin_range {Y T : Type*} [TopologicalSpace Y]
    {Φ : T → C(Y, ℝ)} (hΦ : (Set.range fun t => (Φ t : Y → ℝ)).SeparatesPoints) :
    (Algebra.adjoin ℝ (Set.range Φ)).SeparatesPoints := by
  intro x y hxy
  obtain ⟨_, ⟨t, rfl⟩, ht⟩ := hΦ hxy
  exact ⟨Φ t, ⟨Φ t, Algebra.subset_adjoin ⟨t, rfl⟩, rfl⟩, ht⟩

/-! ### Separating subalgebras on a compact space -/

section Compact

variable {Y : Type*} [TopologicalSpace Y] [CompactSpace Y] [MeasurableSpace Y]
  [OpensMeasurableSpace Y]

/-- A continuous function on a compact space is integrable against a finite measure. -/
lemma ContinuousMap.integrable_of_compactSpace (ν : Measure Y) [IsFiniteMeasure ν]
    (a : C(Y, ℝ)) : Integrable (fun y => a y) ν :=
  (BoundedContinuousFunction.mkOfCompact a).integrable ν

/-- Integration against a finite measure on a compact space is Lipschitz for the sup norm. -/
lemma ContinuousMap.dist_integral_le_of_compactSpace (ν : Measure Y) [IsFiniteMeasure ν]
    (a b : C(Y, ℝ)) :
    dist (∫ y, a y ∂ν) (∫ y, b y ∂ν) ≤ ν.real Set.univ * dist a b := by
  rw [dist_eq_norm, ← integral_sub (ContinuousMap.integrable_of_compactSpace ν a)
    (ContinuousMap.integrable_of_compactSpace ν b), dist_eq_norm]
  have h := (BoundedContinuousFunction.mkOfCompact (a - b)).norm_integral_le_mul_norm ν
  simpa [← dist_eq_norm, BoundedContinuousFunction.dist_mkOfCompact] using h

/-- Integration against a finite measure on a compact space is continuous for the sup norm. -/
lemma ContinuousMap.continuous_integral_of_compactSpace (ν : Measure Y) [IsFiniteMeasure ν] :
    Continuous fun a : C(Y, ℝ) => ∫ y, a y ∂ν := by
  refine (LipschitzWith.of_dist_le_mul (K := (ν Set.univ).toNNReal) fun a b => ?_).continuous
  simpa [Measure.real, ENNReal.coe_toNNReal_eq_toReal] using
    ContinuousMap.dist_integral_le_of_compactSpace ν a b

/-- Two finite measures on a compact space whose integrals agree on a subalgebra of
`C(Y, ℝ)` that separates points are equal. -/
theorem Measure.ext_of_forall_mem_subalgebra_integral_eq_of_compactSpace [BorelSpace Y]
    [HasOuterApproxClosed Y] {ν₁ ν₂ : Measure Y} [IsFiniteMeasure ν₁] [IsFiniteMeasure ν₂]
    {A : Subalgebra ℝ C(Y, ℝ)} (hA : A.SeparatesPoints)
    (h : ∀ a ∈ A, ∫ y, a y ∂ν₁ = ∫ y, a y ∂ν₂) : ν₁ = ν₂ := by
  refine ext_of_forall_integral_eq_of_IsFiniteMeasure fun f => ?_
  have hcl : closure (A : Set C(Y, ℝ)) ⊆ {a | ∫ y, a y ∂ν₁ = ∫ y, a y ∂ν₂} :=
    (isClosed_eq (ContinuousMap.continuous_integral_of_compactSpace ν₁)
      (ContinuousMap.continuous_integral_of_compactSpace ν₂)).closure_subset_iff.2 h
  have hmem : (f : C(Y, ℝ)) ∈ closure (A : Set C(Y, ℝ)) := by
    rw [← Subalgebra.topologicalClosure_coe,
      ContinuousMap.subalgebra_topologicalClosure_eq_top_of_separatesPoints A hA]
    trivial
  exact hcl hmem

/-- Probability measures on a compact space converge weakly as soon as their integrals
against every element of a separating subalgebra of `C(Y, ℝ)` converge. -/
theorem ProbabilityMeasure.tendsto_of_forall_mem_subalgebra_integral_tendsto_of_compactSpace
    {ι : Type*} {l : Filter ι} {μ : ι → ProbabilityMeasure Y} {μ₀ : ProbabilityMeasure Y}
    {A : Subalgebra ℝ C(Y, ℝ)} (hA : A.SeparatesPoints)
    (h : ∀ a ∈ A, Tendsto (fun i => ∫ y, a y ∂(μ i : Measure Y)) l
      (𝓝 (∫ y, a y ∂(μ₀ : Measure Y)))) :
    Tendsto μ l (𝓝 μ₀) := by
  rw [ProbabilityMeasure.tendsto_iff_forall_integral_tendsto]
  intro g
  rw [Metric.tendsto_nhds]
  intro ε hε
  obtain ⟨a, ha⟩ := ContinuousMap.exists_mem_subalgebra_near_continuousMap_of_separatesPoints
    A hA (g : C(Y, ℝ)) (ε / 3) (by positivity)
  have hag : dist (a : C(Y, ℝ)) (g : C(Y, ℝ)) < ε / 3 := by rwa [dist_eq_norm]
  filter_upwards [Metric.tendsto_nhds.1 (h a a.2) (ε / 3) (by positivity)] with i hi
  have h1 := ContinuousMap.dist_integral_le_of_compactSpace (μ i : Measure Y) (g : C(Y, ℝ)) a
  have h2 := ContinuousMap.dist_integral_le_of_compactSpace (μ₀ : Measure Y) a (g : C(Y, ℝ))
  simp only [probReal_univ, one_mul] at h1 h2
  rw [dist_comm (g : C(Y, ℝ))] at h1
  calc dist (∫ y, g y ∂(μ i : Measure Y)) (∫ y, g y ∂(μ₀ : Measure Y))
      ≤ dist (∫ y, g y ∂(μ i : Measure Y)) (∫ y, (a : C(Y, ℝ)) y ∂(μ i : Measure Y))
        + dist (∫ y, (a : C(Y, ℝ)) y ∂(μ i : Measure Y)) (∫ y, (a : C(Y, ℝ)) y ∂(μ₀ : Measure Y))
        + dist (∫ y, (a : C(Y, ℝ)) y ∂(μ₀ : Measure Y)) (∫ y, g y ∂(μ₀ : Measure Y)) :=
        dist_triangle4 _ _ _ _
    _ < ε / 3 + ε / 3 + ε / 3 :=
        add_lt_add (add_lt_add (h1.trans_lt hag) hi) (h2.trans_lt hag)
    _ = ε := by ring

/-! ### Moments of a separating family -/

variable {T : Type*} {Φ : T → C(Y, ℝ)}

/-- If all moments `∫ ∏ i, Φ (f i)` of two finite measures agree, so do their integrals against
every element of the algebra generated by `Φ`. -/
lemma integral_eq_of_mem_adjoin_of_forall_moment_integral_eq {ν₁ ν₂ : Measure Y}
    [IsFiniteMeasure ν₁] [IsFiniteMeasure ν₂]
    (h : ∀ (n : ℕ) (f : Fin n → T), ∫ y, ∏ i, Φ (f i) y ∂ν₁ = ∫ y, ∏ i, Φ (f i) y ∂ν₂)
    {a : C(Y, ℝ)} (ha : a ∈ Algebra.adjoin ℝ (Set.range Φ)) :
    ∫ y, a y ∂ν₁ = ∫ y, a y ∂ν₂ := by
  refine Algebra.adjoin_range_induction_prod Φ (p := fun a : C(Y, ℝ) => ∫ y, a y ∂ν₁ = ∫ y, a y ∂ν₂)
    ?_ ?_ ?_ ?_ ha
  · simp
  · intro x z hx hz
    simp only [ContinuousMap.add_apply]
    rw [integral_add (ContinuousMap.integrable_of_compactSpace ν₁ x)
        (ContinuousMap.integrable_of_compactSpace ν₁ z),
      integral_add (ContinuousMap.integrable_of_compactSpace ν₂ x)
        (ContinuousMap.integrable_of_compactSpace ν₂ z), hx, hz]
  · intro r x hx
    simp only [ContinuousMap.smul_apply, smul_eq_mul, integral_const_mul, hx]
  · intro n f
    simpa using h n f

/-- If all moments `∫ ∏ i, Φ (f i)` converge, so do the integrals against every element of the
algebra generated by `Φ`. -/
lemma tendsto_integral_of_mem_adjoin_of_forall_moment_tendsto {ι : Type*} {l : Filter ι}
    {μ : ι → ProbabilityMeasure Y} {μ₀ : ProbabilityMeasure Y}
    (h : ∀ (n : ℕ) (f : Fin n → T), Tendsto (fun i => ∫ y, ∏ j, Φ (f j) y ∂(μ i : Measure Y)) l
      (𝓝 (∫ y, ∏ j, Φ (f j) y ∂(μ₀ : Measure Y))))
    {a : C(Y, ℝ)} (ha : a ∈ Algebra.adjoin ℝ (Set.range Φ)) :
    Tendsto (fun i => ∫ y, a y ∂(μ i : Measure Y)) l (𝓝 (∫ y, a y ∂(μ₀ : Measure Y))) := by
  refine Algebra.adjoin_range_induction_prod Φ (p := fun a : C(Y, ℝ) =>
    Tendsto (fun i => ∫ y, a y ∂(μ i : Measure Y)) l (𝓝 (∫ y, a y ∂(μ₀ : Measure Y))))
    ?_ ?_ ?_ ?_ ha
  · simpa using tendsto_const_nhds
  · intro x z hx hz
    have hint : ∀ ν : Measure Y, IsFiniteMeasure ν →
        ∫ y, (x + z) y ∂ν = ∫ y, x y ∂ν + ∫ y, z y ∂ν := fun ν _ =>
      integral_add (ContinuousMap.integrable_of_compactSpace ν x)
        (ContinuousMap.integrable_of_compactSpace ν z)
    simp only [hint _ inferInstance]
    exact hx.add hz
  · intro r x hx
    simp only [ContinuousMap.smul_apply, smul_eq_mul, integral_const_mul]
    exact hx.const_mul r
  · intro n f
    simpa using h n f

/-- **Moment determinacy.** Two finite measures on a compact space with the same
moments `∫ ∏ i, Φ (f i)` against a separating family `Φ` are equal. -/
theorem Measure.ext_of_forall_moment_integral_eq [BorelSpace Y] [HasOuterApproxClosed Y]
    {ν₁ ν₂ : Measure Y} [IsFiniteMeasure ν₁] [IsFiniteMeasure ν₂]
    (hΦ : (Set.range fun t => (Φ t : Y → ℝ)).SeparatesPoints)
    (h : ∀ (n : ℕ) (f : Fin n → T), ∫ y, ∏ i, Φ (f i) y ∂ν₁ = ∫ y, ∏ i, Φ (f i) y ∂ν₂) :
    ν₁ = ν₂ :=
  Measure.ext_of_forall_mem_subalgebra_integral_eq_of_compactSpace
    (Subalgebra.separatesPoints_adjoin_range hΦ)
    fun _ ha => integral_eq_of_mem_adjoin_of_forall_moment_integral_eq h ha

/-- **Method of moments.** Probability measures on a compact space whose moments
`∫ ∏ i, Φ (f i)` against a separating family `Φ` all converge to those of `μ₀` converge weakly
to `μ₀`. -/
theorem ProbabilityMeasure.tendsto_of_forall_moment_tendsto {ι : Type*} {l : Filter ι}
    {μ : ι → ProbabilityMeasure Y} {μ₀ : ProbabilityMeasure Y}
    (hΦ : (Set.range fun t => (Φ t : Y → ℝ)).SeparatesPoints)
    (h : ∀ (n : ℕ) (f : Fin n → T), Tendsto (fun i => ∫ y, ∏ j, Φ (f j) y ∂(μ i : Measure Y)) l
      (𝓝 (∫ y, ∏ j, Φ (f j) y ∂(μ₀ : Measure Y)))) :
    Tendsto μ l (𝓝 μ₀) :=
  ProbabilityMeasure.tendsto_of_forall_mem_subalgebra_integral_tendsto_of_compactSpace
    (Subalgebra.separatesPoints_adjoin_range hΦ)
    fun _ ha => tendsto_integral_of_mem_adjoin_of_forall_moment_tendsto h ha

end Compact

/-! ### Laws of random probability measures

The test functions are the integration functionals `μ ↦ ∫ x, g x ∂μ`, continuous on
`ProbabilityMeasure X` by `ProbabilityMeasure.continuous_integral_continuousMap`; the moments of
the general theory are then `∫ ∏ i, ∫ x, g i x ∂μ`. -/

section RandomMeasure

variable {X : Type*} [TopologicalSpace X] [MeasurableSpace X] [BorelSpace X]

/-- Distinct probability measures are separated by the integral of some continuous function. -/
theorem ProbabilityMeasure.exists_integral_ne_of_ne [HasOuterApproxClosed X]
    {μ₁ μ₂ : ProbabilityMeasure X} (hne : μ₁ ≠ μ₂) :
    ∃ g : C(X, ℝ), ∫ x, g x ∂(μ₁ : Measure X) ≠ ∫ x, g x ∂(μ₂ : Measure X) := by
  by_contra! h
  exact hne (ProbabilityMeasure.toMeasure_injective
    (ext_of_forall_integral_eq_of_IsFiniteMeasure fun f => h f))

variable [CompactSpace X] [T2Space X] [TopologicalSpace.PseudoMetrizableSpace X]

omit [T2Space X] in
/-- Distinct probability measures on a compact metrizable space are separated by the integral of
an element of any separating subalgebra of `C(X, ℝ)`. -/
theorem ProbabilityMeasure.exists_mem_subalgebra_integral_ne_of_ne
    {A : Subalgebra ℝ C(X, ℝ)} (hA : A.SeparatesPoints) {μ₁ μ₂ : ProbabilityMeasure X}
    (hne : μ₁ ≠ μ₂) :
    ∃ a ∈ A, ∫ x, a x ∂(μ₁ : Measure X) ≠ ∫ x, a x ∂(μ₂ : Measure X) := by
  by_contra! h
  exact hne (ProbabilityMeasure.toMeasure_injective
    (Measure.ext_of_forall_mem_subalgebra_integral_eq_of_compactSpace hA h))

/-- **Moment determinacy for random measures.** Two finite measures on `ProbabilityMeasure X`,
`X` compact metrizable, with the same moments `∫ ∏ i, ∫ x, a i x ∂μ` for `a i` in a separating
subalgebra `A ⊆ C(X, ℝ)` are equal. -/
theorem Measure.ext_of_forall_integral_prod_integral_eq_of_separatesPoints
    [MeasurableSpace (ProbabilityMeasure X)] [BorelSpace (ProbabilityMeasure X)]
    [HasOuterApproxClosed (ProbabilityMeasure X)]
    {A : Subalgebra ℝ C(X, ℝ)} (hA : A.SeparatesPoints)
    {ν₁ ν₂ : Measure (ProbabilityMeasure X)} [IsFiniteMeasure ν₁] [IsFiniteMeasure ν₂]
    (h : ∀ (n : ℕ) (a : Fin n → A),
      ∫ μ, ∏ i, ∫ x, (a i : C(X, ℝ)) x ∂(μ : Measure X) ∂ν₁
        = ∫ μ, ∏ i, ∫ x, (a i : C(X, ℝ)) x ∂(μ : Measure X) ∂ν₂) :
    ν₁ = ν₂ := by
  refine Measure.ext_of_forall_moment_integral_eq
    (Φ := fun a : A => (⟨fun μ : ProbabilityMeasure X => ∫ x, (a : C(X, ℝ)) x ∂(μ : Measure X),
      ProbabilityMeasure.continuous_integral_continuousMap _⟩ : C(ProbabilityMeasure X, ℝ)))
    (fun μ₁ μ₂ hne => ?_) h
  obtain ⟨a, haA, ha⟩ := ProbabilityMeasure.exists_mem_subalgebra_integral_ne_of_ne hA hne
  exact ⟨_, ⟨⟨a, haA⟩, rfl⟩, ha⟩

/-- **Moment determinacy for random measures.** Two finite measures on `ProbabilityMeasure X`,
`X` compact metrizable, with the same moments `∫ ∏ i, ∫ x, g i x ∂μ`, `g i ∈ C(X, ℝ)`, are
equal. -/
theorem Measure.ext_of_forall_integral_prod_integral_eq
    [MeasurableSpace (ProbabilityMeasure X)] [BorelSpace (ProbabilityMeasure X)]
    [HasOuterApproxClosed (ProbabilityMeasure X)]
    {ν₁ ν₂ : Measure (ProbabilityMeasure X)} [IsFiniteMeasure ν₁] [IsFiniteMeasure ν₂]
    (h : ∀ (n : ℕ) (g : Fin n → C(X, ℝ)),
      ∫ μ, ∏ i, ∫ x, g i x ∂(μ : Measure X) ∂ν₁
        = ∫ μ, ∏ i, ∫ x, g i x ∂(μ : Measure X) ∂ν₂) :
    ν₁ = ν₂ := by
  refine Measure.ext_of_forall_moment_integral_eq
    (Φ := fun g : C(X, ℝ) => (⟨fun μ : ProbabilityMeasure X => ∫ x, g x ∂(μ : Measure X),
      ProbabilityMeasure.continuous_integral_continuousMap _⟩ : C(ProbabilityMeasure X, ℝ)))
    (fun μ₁ μ₂ hne => ?_) h
  obtain ⟨g, hg⟩ := ProbabilityMeasure.exists_integral_ne_of_ne hne
  exact ⟨_, ⟨g, rfl⟩, hg⟩

/-- **Method of moments for random measures.** Laws of random probability measures on a compact
metrizable `X` whose moments `∫ ∏ i, ∫ x, a i x ∂μ`, `a i` in a separating subalgebra
`A ⊆ C(X, ℝ)`, converge to those of `ν₀` converge weakly to `ν₀`. -/
theorem ProbabilityMeasure.tendsto_of_forall_integral_prod_integral_tendsto_of_separatesPoints
    [MeasurableSpace (ProbabilityMeasure X)] [OpensMeasurableSpace (ProbabilityMeasure X)]
    {A : Subalgebra ℝ C(X, ℝ)} (hA : A.SeparatesPoints)
    {ι : Type*} {l : Filter ι} {ν : ι → ProbabilityMeasure (ProbabilityMeasure X)}
    {ν₀ : ProbabilityMeasure (ProbabilityMeasure X)}
    (h : ∀ (n : ℕ) (a : Fin n → A),
      Tendsto (fun k => ∫ μ, ∏ i, ∫ x, (a i : C(X, ℝ)) x ∂(μ : Measure X)
          ∂(ν k : Measure (ProbabilityMeasure X))) l
        (𝓝 (∫ μ, ∏ i, ∫ x, (a i : C(X, ℝ)) x ∂(μ : Measure X)
          ∂(ν₀ : Measure (ProbabilityMeasure X))))) :
    Tendsto ν l (𝓝 ν₀) := by
  refine ProbabilityMeasure.tendsto_of_forall_moment_tendsto
    (Φ := fun a : A => (⟨fun μ : ProbabilityMeasure X => ∫ x, (a : C(X, ℝ)) x ∂(μ : Measure X),
      ProbabilityMeasure.continuous_integral_continuousMap _⟩ : C(ProbabilityMeasure X, ℝ)))
    (fun μ₁ μ₂ hne => ?_) h
  obtain ⟨a, haA, ha⟩ := ProbabilityMeasure.exists_mem_subalgebra_integral_ne_of_ne hA hne
  exact ⟨_, ⟨⟨a, haA⟩, rfl⟩, ha⟩

/-- **Method of moments for random measures.** Laws of random probability measures on a compact
metrizable `X` whose moments `∫ ∏ i, ∫ x, g i x ∂μ`, `g i ∈ C(X, ℝ)`, converge to those of `ν₀`
converge weakly to `ν₀`. -/
theorem ProbabilityMeasure.tendsto_of_forall_integral_prod_integral_tendsto
    [MeasurableSpace (ProbabilityMeasure X)] [OpensMeasurableSpace (ProbabilityMeasure X)]
    {ι : Type*} {l : Filter ι} {ν : ι → ProbabilityMeasure (ProbabilityMeasure X)}
    {ν₀ : ProbabilityMeasure (ProbabilityMeasure X)}
    (h : ∀ (n : ℕ) (g : Fin n → C(X, ℝ)),
      Tendsto (fun k => ∫ μ, ∏ i, ∫ x, g i x ∂(μ : Measure X)
          ∂(ν k : Measure (ProbabilityMeasure X))) l
        (𝓝 (∫ μ, ∏ i, ∫ x, g i x ∂(μ : Measure X) ∂(ν₀ : Measure (ProbabilityMeasure X))))) :
    Tendsto ν l (𝓝 ν₀) := by
  refine ProbabilityMeasure.tendsto_of_forall_moment_tendsto
    (Φ := fun g : C(X, ℝ) => (⟨fun μ : ProbabilityMeasure X => ∫ x, g x ∂(μ : Measure X),
      ProbabilityMeasure.continuous_integral_continuousMap _⟩ : C(ProbabilityMeasure X, ℝ)))
    (fun μ₁ μ₂ hne => ?_) h
  obtain ⟨g, hg⟩ := ProbabilityMeasure.exists_integral_ne_of_ne hne
  exact ⟨_, ⟨g, rfl⟩, hg⟩

end RandomMeasure

/-! ### Polynomial test functions on a compact subset of `ℝ^d`

The polynomial functions on `K` are the range of `MvPolynomial.aeval` at the coordinate
functions `x ↦ x i`, a subalgebra of `C(K, ℝ)` that separates points. -/

section Polynomial

variable {d : ℕ} {K : Set (Fin d → ℝ)}

private theorem aeval_coord_apply (P : MvPolynomial (Fin d) ℝ) (x : K) :
    MvPolynomial.aeval (fun i => (⟨fun y : K => (y : Fin d → ℝ) i,
      (continuous_apply i).comp continuous_subtype_val⟩ : C(K, ℝ))) P x
      = P.eval (x : Fin d → ℝ) := by
  induction P using MvPolynomial.induction_on with
  | C a => simp
  | add p q hp hq => simp [hp, hq]
  | mul_X p i hp => simp [hp]

private theorem separatesPoints_range_aeval_coord :
    (MvPolynomial.aeval (R := ℝ)
      (fun i => (⟨fun y : K => (y : Fin d → ℝ) i,
        (continuous_apply i).comp continuous_subtype_val⟩ : C(K, ℝ)))).range.SeparatesPoints := by
  intro x y hxy
  have hne : (x : Fin d → ℝ) ≠ (y : Fin d → ℝ) := fun h => hxy (Subtype.ext h)
  obtain ⟨i, hi⟩ := Function.ne_iff.mp hne
  exact ⟨_, ⟨_, ⟨MvPolynomial.X i, MvPolynomial.aeval_X _ i⟩, rfl⟩, hi⟩

/-- **Polynomial moments determine the law.** For random probability measures on a compact
`K ⊆ ℝ^d`, two laws coincide as soon as all polynomial moments `∫ ∏ i, ∫ x, P_i(x) dμ` agree.
This is the form of the moment hypothesis of Theorem I.5.21 and Corollary I.5.22. -/
theorem Measure.ext_of_forall_polynomial_moment_eq
    [CompactSpace K] [MeasurableSpace K] [BorelSpace K]
    [MeasurableSpace (ProbabilityMeasure K)] [BorelSpace (ProbabilityMeasure K)]
    [HasOuterApproxClosed (ProbabilityMeasure K)]
    {ν₁ ν₂ : Measure (ProbabilityMeasure K)} [IsFiniteMeasure ν₁] [IsFiniteMeasure ν₂]
    (h : ∀ (n : ℕ) (P : Fin n → MvPolynomial (Fin d) ℝ),
      ∫ μ, ∏ i, ∫ x, (P i).eval (x : Fin d → ℝ) ∂(μ : Measure K) ∂ν₁
        = ∫ μ, ∏ i, ∫ x, (P i).eval (x : Fin d → ℝ) ∂(μ : Measure K) ∂ν₂) :
    ν₁ = ν₂ := by
  refine Measure.ext_of_forall_integral_prod_integral_eq_of_separatesPoints
    separatesPoints_range_aeval_coord fun n a => ?_
  choose P hP using fun i => (AlgHom.mem_range _).1 (a i).2
  simpa only [← hP, aeval_coord_apply] using h n P

/-- **Convergence in law from polynomial moment convergence** for random probability measures on
a compact `K ⊆ ℝ^d`. -/
theorem ProbabilityMeasure.tendsto_of_forall_polynomial_moment_tendsto
    [CompactSpace K] [MeasurableSpace K] [BorelSpace K]
    [MeasurableSpace (ProbabilityMeasure K)] [OpensMeasurableSpace (ProbabilityMeasure K)]
    {ι : Type*} {l : Filter ι} {ν : ι → ProbabilityMeasure (ProbabilityMeasure K)}
    {ν₀ : ProbabilityMeasure (ProbabilityMeasure K)}
    (h : ∀ (n : ℕ) (P : Fin n → MvPolynomial (Fin d) ℝ),
      Tendsto (fun k => ∫ μ, ∏ i, ∫ x, (P i).eval (x : Fin d → ℝ) ∂(μ : Measure K)
          ∂(ν k : Measure (ProbabilityMeasure K))) l
        (𝓝 (∫ μ, ∏ i, ∫ x, (P i).eval (x : Fin d → ℝ) ∂(μ : Measure K)
          ∂(ν₀ : Measure (ProbabilityMeasure K))))) :
    Tendsto ν l (𝓝 ν₀) := by
  refine ProbabilityMeasure.tendsto_of_forall_integral_prod_integral_tendsto_of_separatesPoints
    separatesPoints_range_aeval_coord fun n a => ?_
  choose P hP using fun i => (AlgHom.mem_range _).1 (a i).2
  simpa only [← hP, aeval_coord_apply] using h n P

end Polynomial

/-! ### Non-compact carriers: tightness -/

section Tight

variable {Y : Type*} [TopologicalSpace Y] [T2Space Y] [MeasurableSpace Y] [BorelSpace Y]

/-- **Tightness, moment convergence and determinacy imply weak convergence.** If the laws `μ i`
form a tight family, all their moments `∫ ∏ j, Φ (f j)` (bounded continuous `Φ`) converge to
those of `μ₀`, and `μ₀` is the only probability measure with these moments, then `μ i → μ₀`
weakly. This is the logical form of the step from the moment asymptotics of Theorem I.5.21 to
Corollary I.5.22; in the paper determinacy comes from Carleman's criterion. -/
theorem ProbabilityMeasure.tendsto_of_isTightMeasureSet_of_moment_tendsto {T : Type*}
    {Φ : T → Y →ᵇ ℝ} {ι : Type*} {l : Filter ι} {μ : ι → ProbabilityMeasure Y}
    {μ₀ : ProbabilityMeasure Y}
    (hdet : ∀ μ' : ProbabilityMeasure Y,
      (∀ (n : ℕ) (f : Fin n → T),
        ∫ y, ∏ j, Φ (f j) y ∂(μ' : Measure Y) = ∫ y, ∏ j, Φ (f j) y ∂(μ₀ : Measure Y)) →
      μ' = μ₀)
    (htight : IsTightMeasureSet {(μ i : Measure Y) | i})
    (h : ∀ (n : ℕ) (f : Fin n → T), Tendsto (fun i => ∫ y, ∏ j, Φ (f j) y ∂(μ i : Measure Y)) l
      (𝓝 (∫ y, ∏ j, Φ (f j) y ∂(μ₀ : Measure Y)))) :
    Tendsto μ l (𝓝 μ₀) := by
  obtain rfl | _ := l.eq_or_neBot
  · simp
  refine (Filter.tendsto_iff_ultrafilter _ _ _).2 fun U hU => ?_
  have h_compact : IsCompact (closure {μ i | i}) :=
    isCompact_closure_of_isTightMeasureSet (by simpa using htight)
  obtain ⟨μ', -, hμ' : Tendsto _ _ _⟩ := h_compact.ultrafilter_le_nhds (U.map μ)
    (.trans (by simp) (monotone_principal subset_closure))
  suffices μ' = μ₀ by rwa [this] at hμ'
  refine hdet μ' fun n f => ?_
  have hc := ProbabilityMeasure.continuous_integral_boundedContinuousFunction
    (∏ j, Φ (f j) : Y →ᵇ ℝ)
  have h1 : Tendsto (fun i => ∫ y, ∏ j, Φ (f j) y ∂(μ i : Measure Y)) (U : Filter ι)
      (𝓝 (∫ y, ∏ j, Φ (f j) y ∂(μ' : Measure Y))) := by
    simpa [Function.comp_def] using (hc.tendsto μ').comp hμ'
  exact tendsto_nhds_unique h1 ((h n f).mono_left hU)

/-- **Tightness from uniform bounds on the expected outer mass.** If for every `ε > 0` there is a
compact `K ⊆ Y` such that the expected mass `∫ μ(Kᶜ) dν_k` of the random probability measure is at
most `ε²` uniformly in `k`, then the laws `ν_k` are tight. -/
theorem ProbabilityMeasure.isTightMeasureSet_of_uniform_lintegral_bound [NormalSpace Y]
    {ι : Type*} (ν : ι → ProbabilityMeasure (ProbabilityMeasure Y))
    (h : ∀ ε : ℝ≥0, 0 < ε → ∃ K : Set Y, IsCompact K ∧ ∀ k,
      ∫⁻ μ : ProbabilityMeasure Y, (μ : Measure Y) Kᶜ ∂(ν k : Measure (ProbabilityMeasure Y))
        ≤ (ε : ℝ≥0∞) * (ε : ℝ≥0∞)) :
    IsTightMeasureSet {(ν k : Measure (ProbabilityMeasure Y)) | k} := by
  rw [isTightMeasureSet_iff_exists_isCompact_measure_compl_le]
  intro ε hε
  rcases eq_or_ne ε ⊤ with htop | htop
  · exact ⟨∅, isCompact_empty, fun μ _ => by rw [htop]; exact le_top⟩
  rw [← ENNReal.coe_toNNReal htop]
  set e : ℝ≥0 := ε.toNNReal with he
  have he0 : 0 < e := ENNReal.toNNReal_pos hε.ne' htop
  set u : ℕ → ℝ≥0 := fun n => e * (1 / 2 : ℝ≥0) ^ (n + 1) with hu
  choose K hK hKB using fun n : ℕ => h (u n) (by positivity)
  have hu_tendsto : Tendsto u atTop (𝓝 0) := by
    have h2 : Tendsto (fun n : ℕ => (1 / 2 : ℝ≥0) ^ (n + 1)) atTop (𝓝 0) :=
      (tendsto_pow_atTop_nhds_zero_of_lt_one (by positivity) (by norm_num)).comp
        (tendsto_add_atTop_nat 1)
    have h3 := h2.const_mul e
    rwa [mul_zero] at h3
  have hcomp : IsCompact {μ : ProbabilityMeasure Y | ∀ n, μ (K n)ᶜ ≤ u n} :=
    isCompact_setOfPred_probabilityMeasure_mass_eq_compl_isCompact_le hu_tendsto hK
      (Or.inl inferInstance)
  refine ⟨_, hcomp, ?_⟩
  rintro _ ⟨k, rfl⟩
  have hsubset : {μ : ProbabilityMeasure Y | ∀ n, μ (K n)ᶜ ≤ u n}ᶜ
      ⊆ ⋃ n, {μ : ProbabilityMeasure Y | (u n : ℝ≥0∞) ≤ (μ : Measure Y) (K n)ᶜ} := by
    intro μ hμ
    simp only [Set.mem_compl_iff, Set.mem_ofPred_eq, not_forall, not_le] at hμ
    obtain ⟨n, hn⟩ := hμ
    refine Set.mem_iUnion.2 ⟨n, ?_⟩
    rw [Set.mem_ofPred_eq, ← ProbabilityMeasure.ennreal_coeFn_eq_coeFn_toMeasure]
    exact_mod_cast hn.le
  calc (ν k : Measure (ProbabilityMeasure Y)) {μ | ∀ n, μ (K n)ᶜ ≤ u n}ᶜ
      ≤ ∑' n, (ν k : Measure (ProbabilityMeasure Y))
          {μ : ProbabilityMeasure Y | (u n : ℝ≥0∞) ≤ (μ : Measure Y) (K n)ᶜ} :=
        (measure_mono hsubset).trans (measure_iUnion_le _)
    _ ≤ ∑' n, (u n : ℝ≥0∞) := by
        refine ENNReal.tsum_le_tsum fun n => ?_
        have hmeas : Measurable fun μ : ProbabilityMeasure Y => (μ : Measure Y) (K n)ᶜ :=
          (Measure.measurable_coe (hK n).isClosed.measurableSet.compl).comp
            measurable_subtype_coe
        have hu0 : (u n : ℝ≥0∞) ≠ 0 := by simp [hu, he0.ne']
        calc _ ≤ (∫⁻ μ : ProbabilityMeasure Y, (μ : Measure Y) (K n)ᶜ
                ∂(ν k : Measure (ProbabilityMeasure Y))) / (u n : ℝ≥0∞) :=
              meas_ge_le_lintegral_div hmeas.aemeasurable hu0 ENNReal.coe_ne_top
          _ ≤ (u n : ℝ≥0∞) := by
              rw [ENNReal.div_le_iff hu0 ENNReal.coe_ne_top]
              exact hKB n k
    _ = (e : ℝ≥0∞) := by
        simp only [hu, ENNReal.coe_mul, ENNReal.coe_pow, one_div, ENNReal.coe_inv two_ne_zero,
          ENNReal.coe_ofNat, ENNReal.tsum_mul_left, ENNReal.tsum_geometric_add_one,
          ENNReal.one_sub_inv_two, inv_inv, ENNReal.inv_mul_cancel two_ne_zero ENNReal.ofNat_ne_top,
          mul_one]

end Tight

end PercLib.Probability
